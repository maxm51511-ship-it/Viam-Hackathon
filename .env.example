# Copy to .env (git-ignored) and fill in. Never commit real values.
# Viam app -> machine -> CONNECT tab -> API keys / address.
VIAM_MACHINE_ADDRESS=your-machine-main.xxxxxxxx.viam.cloud
VIAM_API_KEY=
VIAM_API_KEY_ID=

# Physical motion interlock. Leave unset (dry-run) unless motion has been
# validated in simulation and the E-stop is within reach.
# PRINTBOT_ALLOW_MOTION=1

# Optional alternative settings file
# PRINTBOT_SETTINGS=config/settings.json
